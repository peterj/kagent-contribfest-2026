{
  "name": "kagent-contribfest-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=site --watch-path=participant-guide.md --watch-path=scripts/build.mjs scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cloudflare:login": "wrangler login",
    "verify:lab": "node scripts/verify-lab.mjs",
    "verify:browser": "node --test tests/reference-ui.test.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/site.test.mjs tests/deploy.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "highlight.js": "^11.12.0",
    "lucide": "^0.468.0",
    "marked": "^16.4.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.56.0",
    "qrcode": "^1.5.4",
    "wrangler": "^4.156.0"
  }
}
